# Django secret used to sign tokens and internal cryptographic values.
DJANGO_SECRET_KEY=replace-with-a-secure-secret

# Enables Django debug features. Keep False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames and IPs accepted in the Host header.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Force django-cors-headers to allow every origin.
# This is also automatically enabled if DJANGO_CORS_ALLOWED_ORIGINS contains "*".
DJANGO_CORS_ALLOW_ALL_ORIGINS=False

# Allows cookies and Authorization headers on cross-origin requests.
DJANGO_CORS_ALLOW_CREDENTIALS=True

# Comma-separated origins allowed by CORS.
# Use "*" to allow every origin.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:1111,http://127.0.0.1:1111

# Comma-separated origins trusted by Django CSRF protection.
# Django does not accept "*" here.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:1111,http://127.0.0.1:1111

# Time zone used by Django for display and timestamp conversions.
DJANGO_TIME_ZONE=UTC

# Logging verbosity for console and file logs.
DJANGO_LOG_LEVEL=INFO

# PostgreSQL connection used by backend/utils/database.py.
DJANGO_DB_HOST=192.168.1.64
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=auth_service
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=postgres

# Seconds to wait before the PostgreSQL connection attempt times out.
DJANGO_DB_CONNECT_TIMEOUT=5

# SSH connection used by backend/nginx/builder.py for nginx deploy/restore.
NGINX_SSH_HOST=192.168.1.49
NGINX_SSH_PORT=22
NGINX_SSH_USER=luis
NGINX_SSH_PASSWORD=replace-with-a-secure-password
# Optional private key path. Leave empty when using password authentication.
NGINX_SSH_KEY_PATH=
